#!/usr/bin/env bash
# Rebuilds the local binary when the source is newer, then runs it. Same pattern as bin/agentmux.
set -euo pipefail

unset CDPATH
DIR=$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
BINARY="$DIR/target/release/rexflash"

# A Rex layer may start with a short PATH, so add the places mise and rustup put cargo.
export PATH="$HOME/.local/share/mise/shims:$HOME/.cargo/bin:$PATH"

if [[ ! -x "$BINARY" ]] \
  || [[ "$DIR/Cargo.toml" -nt "$BINARY" ]] \
  || [[ "$DIR/Cargo.lock" -nt "$BINARY" ]] \
  || [[ -n "$(find "$DIR/src" -type f -newer "$BINARY" -print -quit)" ]]; then
  if ! command -v cargo >/dev/null 2>&1; then
    printf 'rexflash: cargo is required to build the updated source\n' >&2
    exit 1
  fi
  printf 'rexflash: building the local binary...\n' >&2
  cargo build --quiet --release --locked --manifest-path "$DIR/Cargo.toml"
fi

exec "$BINARY" "$@"
