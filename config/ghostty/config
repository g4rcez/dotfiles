# vim: ft=ghostty
font-size = 17
adjust-cell-height = 60%
font-thicken = true
font-thicken-strength = 120
window-padding-x = 2
bold-is-bright = true
shell-integration = detect
adjust-cell-width = 2%
theme = TokyoNight
scrollback-limit = 100000
macos-option-as-alt = true
mouse-hide-while-typing = true
macos-titlebar-style = tabs
font-family = "JetBrainsMono Nerd Font"
quick-terminal-animation-duration = 0.5
window-decoration = none
window-theme = ghostty
window-colorspace = display-p3
macos-titlebar-style = transparent

# keybind
keybind = global:super+shift+zero=toggle_quick_terminal
keybind = super+t=new_tab
keybind = super+shift+[=previous_tab
keybind = super+shift+]=next_tab
keybind = super+p>-=new_split:down
keybind = super+p>\=new_split:right
keybind = super+p>equal=equalize_splits
keybind = super+p>h=previous_tab
keybind = super+p>l=next_tab
keybind = super+p>n=new_window
keybind = super+p>r=reload_config
keybind = super+p>t=new_tab
keybind = super+p>p=toggle_command_palette
