{
  "editor.minimap.autohide": "mouseover",
  "window.nativeTabs": true,
  "html-css-class-completion.JavaScriptLanguages": [
    "javascript",
    "javascriptreact",
    "typescriptreact",
  ],
  "cSpell.language": "en,pt,pt_BR",
  "[lua]": { "editor.defaultFormatter": "sumneko.lua" },
  "[html]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[json]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[scss]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[jsonc]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[nginx]": { "editor.defaultFormatter": "raynigon.nginx-formatter" },
  "[markdown]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[javascript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[typescript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[typescriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
  },
  "editor.accessibilitySupport": "off",
  "editor.bracketPairColorization.enabled": true,
  "editor.codeLens": true,
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.defaultColorDecorators": "auto",
  "editor.definitionLinkOpensInPeek": true,
  "editor.fontFamily": "JetBrainsMono Nerd Font",
  "editor.fontLigatures": true,
  "editor.lineHeight": 1.75,
  "editor.fontSize": 17,
  "editor.hideCursorInOverviewRuler": true,
  "editor.lineNumbers": "relative",
  "editor.linkedEditing": true,
  "editor.detectIndentation": false,
  "editor.indentSize": 4,
  "editor.insertSpaces": true,
  "editor.tabSize": 4,
  "editor.minimap.enabled": true,
  "editor.renderLineHighlight": "line",
  "editor.renderLineHighlightOnlyWhenFocus": true,
  "editor.renderWhitespace": "all",
  "editor.scrollBeyondLastColumn": 8,
  "editor.scrollBeyondLastLine": false,
  "editor.cursorSurroundingLines": 10,
  "editor.smoothScrolling": true,
  "editor.stickyScroll.enabled": true,
  "editor.folding": true,
  "editor.foldingHighlight": false,
  "editor.foldingStrategy": "auto",
  "editor.showFoldingControls": "always",
  "editor.wordWrap": "off",
  "editor.suggestSelection": "first",
  "editor.inlayHints.enabled": "on",
  "editor.semanticHighlighting.enabled": true,
  "editor.stickyTabStops": true,
  "explorer.compactFolders": false,
  "explorer.confirmDelete": true,
  "extensions.experimental.affinity": { "asvetliakov.vscode-neovim": 1 },
  "files.associations": { "*.css": "tailwindcss" },
  "files.autoSave": "afterDelay",
  "javascript.updateImportsOnFileMove.enabled": "always",
  "material-icon-theme.files.associations": {
    "*.view.tsx": "razor",
    "*.client.tsx": "robots",
    "*.api.ts": "http",
    "*.mocks.ts": "mocha",
    "*.mocks.tsx": "mocha",
    "links.ts": "http",
    "types.ts": "typescript-def",
    "*.types.ts": "typescript-def",
    "*.step.tsx": "sublime",
  },
  "material-icon-theme.folders.associations": {
    "notification": "messages",
    "http-client": "functions",
    "dom": "views",
  },
  "nxConsole.showNodeVersionOnStartup": false,
  "outline.showNumbers": true,
  "search.showLineNumbers": true,
  "tailwindCSS.emmetCompletions": true,
  "typescript.updateImportsOnFileMove.enabled": "always",
  "vscode-neovim.logOutputToConsole": false,
  "vscode-neovim.neovimExecutablePaths.darwin": "nvim",
  "vscode-neovim.neovimExecutablePaths.linux": "nvim",
  "vscode-neovim.neovimExecutablePaths.win32": "nvim",
  "vscode-neovim.ctrlKeysForNormalMode": [
    "a",
    "b",
    "d",
    "e",
    "f",
    "g",
    "h",
    "i",
    "j",
    "k",
    "l",
    "m",
    "o",
    "r",
    "s",
    "t",
    "u",
    "v",
    "w",
    "x",
    "y",
    "z",
    "/",
    "]"
  ],
  "vscode-neovim.ctrlKeysForInsertMode": [
    "a",
    "c",
    "d",
    "e",
    "h",
    "m",
    "o",
    "r",
    "s",
    "t",
    "u",
    "w",
    "z"
  ],
  "vscode-neovim.compositeTimeout": 150,
  "vscode-neovim.normalSelectionDebounceTime": 100,
  "vscode-neovim.revealCursorScrollLine": true,
  "vscode-neovim.logPath": "",
  "window.commandCenter": false,
  "window.titleBarStyle": "native",
  "workbench.iconTheme": "catppuccin-mocha",
  "workbench.layoutControl.enabled": false,
  "workbench.productIconTheme": "a-file-icon-vscode-product-icon-theme",
  "workbench.settings.editor": "json",
  "workbench.settings.useSplitJSON": true,
  "workbench.sideBar.location": "right",
  "workbench.statusBar.visible": true,
  "[yaml]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
  },
  "git.openRepositoryInParentFolders": "never",
  "tailwindCSS.hovers": true,
  "tailwindCSS.suggestions": true,
  "tailwindCSS.classAttributes": [
    "class",
    "className",
    "ngClass",
    "class:list",
    "cva",
    "container",
  ],
  "notebook.insertFinalNewline": true,
  "notebook.stickyScroll.enabled": true,
  "terminal.integrated.shellIntegration.decorationsEnabled": "gutter",
  "redhat.telemetry.enabled": false,
  "git.autofetch": true,
  "typescript.experimental.useTsgo": true,
  "workbench.colorTheme": "Tokyo Night",
  "workbench.editor.enablePreview": false,
  "workbench.editor.enablePreviewFromQuickOpen": false,
  "workbench.editor.showTabs": "multiple",
  "workbench.editor.tabSizing": "shrink",
  "workbench.editor.splitSizing": "distribute",
  "workbench.editor.revealIfOpen": true,
  "breadcrumbs.enabled": true,
  "search.smartCase": true,
  "files.trimTrailingWhitespace": false,
  "files.trimFinalNewlines": false,
  "editor.formatOnSave": false,
  "editor.formatOnPaste": false,
  "editor.formatOnType": false,
  "debug.inlineValues": true,
  "testing.automaticallyOpenPeekView": "never",
  "vscode-neovim.autoGeneratedDocumentSchemes": [
    "output",
    "vscode-chat-code-block",
    "vscode-copilot-chat-code-block",
  ],
  "tailwindCSS.colorDecorators": true,
"tailwindCSS.codeLens": true,
"[tailwindcss]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
},
}
