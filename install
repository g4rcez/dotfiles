#!/bin/bash
########################################################################################################################
#### ██████╗  ██████╗ ████████╗███████╗██╗██╗     ███████╗███████╗
#### ██╔══██╗██╔═══██╗╚══██╔══╝██╔════╝██║██║     ██╔════╝██╔════╝
#### ██║  ██║██║   ██║   ██║   █████╗  ██║██║     █████╗  ███████╗
#### ██║  ██║██║   ██║   ██║   ██╔══╝  ██║██║     ██╔══╝  ╚════██║
#### ██████╔╝╚██████╔╝   ██║   ██║     ██║███████╗███████╗███████║
#### ╚═════╝  ╚═════╝    ╚═╝   ╚═╝     ╚═╝╚══════╝╚══════╝╚══════╝
########################################################################################################################
set -euo pipefail
INSTALL_DIR="$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
export DOTFILES_DIR="${DOTFILES_DIR:-$INSTALL_DIR}"
source "$DOTFILES_DIR/bin/lib/dotfiles-shell.sh"
HOME_CONFIG_DIR="$HOME/.config"
DOTFILES_CONFIG_DIR="$DOTFILES_DIR/config"
mkdir -p "$HOME/tools"
mkdir -p "$HOME/.tmp"
mkdir -p "$HOME/.config"
zshrc_source="$DOTFILES_DIR/config/zsh/zshrc"
zshrc_destination="$HOME/.zshrc"
if [[ -L "$zshrc_destination" && "$zshrc_destination" -ef "$zshrc_source" ]]; then
    :
elif [[ -e "$zshrc_destination" || -L "$zshrc_destination" ]]; then
    printf 'install: refusing to replace existing %s\n' "$zshrc_destination" >&2
    exit 1
else
    ln -s "$zshrc_source" "$zshrc_destination"
fi

########################################################################################################################
##### mise config
function installmise() {
    curl https://mise.run | sh
    ~/.local/bin/mise activate

    ~/.local/bin/mise install bun@latest
    ~/.local/bin/mise use bun@latest

    ~/.local/bin/mise install node@latest
    ~/.local/bin/mise use node@latest

    ~/.local/bin/mise doctor
}
if ! command -v mise >/dev/null 2>&1; then
    installmise
fi
