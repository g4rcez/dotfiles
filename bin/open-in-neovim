#!/usr/bin/env bash
set -euo pipefail

export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:${HOME}/.local/share/mise/shims:${PATH:-}"

fail() {
  /usr/bin/osascript -e "display alert \"Open in Neovim failed\" message \"$1\" as critical" >/dev/null 2>&1 || true
  printf 'open-in-neovim: %s\n' "$1" >&2
  exit 1
}

# Rex is not on the GUI PATH; the CLI lives inside the Rex Server bundle.
rex_bin=${REX_BIN:-$(command -v rex || true)}
[[ -n "$rex_bin" ]] || rex_bin="$HOME/Library/Application Support/com.superlogical.rex/RexServer/Versions/Current/Rex Server.app/Contents/MacOS/rex"
nvim_bin=${NVIM_BIN:-$(command -v nvim || true)}

[[ -x "$rex_bin" ]] || fail "rex was not found."
[[ -n "$nvim_bin" ]] || fail "nvim was not found in PATH."

cwd=$HOME
if [[ $# -gt 0 ]]; then
  first=$1
  if [[ -d "$first" ]]; then
    cwd=$first
  else
    cwd=$(dirname "$first")
  fi
fi

# `rex run` focuses the new window inside Rex; activating the app brings Rex to the front.
"$rex_bin" run --cwd "$cwd" -- "$nvim_bin" "$@"
/usr/bin/open -a "Rex Beta"
