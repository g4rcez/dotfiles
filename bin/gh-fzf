#!/bin/bash
set -euo pipefail

FZF_GITCLI_FILE=$(mktemp "${TMPDIR:-/tmp}/fzf-gitcli.XXXXXX")
export FZF_GITCLI_FILE
trap 'rm -f -- "$FZF_GITCLI_FILE"' EXIT

gh pr list --json 'body,number,id,title' >"$FZF_GITCLI_FILE"

if [[ "$(jq length "$FZF_GITCLI_FILE")" == 0 ]]; then
  echo "No pull requests available"
  exit 0
fi

jq -c '.[] | .title' "$FZF_GITCLI_FILE" \
  | fzf --ansi --info inline \
  --preview "jq -c -r '.[] | select(.title | contains(\"{}\"))|.body' \"\$FZF_GITCLI_FILE\" | sed 's/\\n/\'$'\n''/g' | sed 's/\\r/''/g'" \
  --bind "enter:become(jq -c -r '.[] | select(.title | contains(\"{}\")) | .number' \"\$FZF_GITCLI_FILE\" | xargs -n 1 gh pr checkout)"
