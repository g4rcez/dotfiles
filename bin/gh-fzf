#!/bin/bash
set -euo pipefail

if [[ "${1:-}" == "--preview" ]]; then
  number="${2:-}"
  if [[ ! "$number" =~ ^[0-9]+$ ]]; then
    printf 'Invalid pull request number: %s\n' "$number" >&2
    exit 2
  fi
  : "${FZF_GITCLI_FILE:?FZF_GITCLI_FILE is required}"
  jq --argjson number "$number" -r '.[] | select(.number == $number) | .body' "$FZF_GITCLI_FILE"
  exit 0
fi

FZF_GITCLI_FILE=$(mktemp "${TMPDIR:-/tmp}/fzf-gitcli.XXXXXX")
export FZF_GITCLI_FILE
trap 'rm -f -- "$FZF_GITCLI_FILE"' EXIT

gh pr list --json 'body,number,id,title' >"$FZF_GITCLI_FILE"

if [[ "$(jq length "$FZF_GITCLI_FILE")" == 0 ]]; then
  echo "No pull requests available"
  exit 0
fi

jq -r '.[] | [.number, .title] | @tsv' "$FZF_GITCLI_FILE" \
  | fzf --ansi --info inline --delimiter $'\t' --with-nth '2..' \
  --preview "$0 --preview {1}" \
  --bind 'enter:become(gh pr checkout {1})'
