#!/usr/bin/env zsh
: ${DOTFILES:=${0:A:h:h}}
source "$DOTFILES/bin/lib/family.zsh"

COMMANDS=(
    'kill-port:kill whatever listens on a TCP port'
    'grep:list processes whose command matches a pattern'
    'ports:list listening TCP ports, optionally filtered by a pattern'
    'memory:top 30 processes by resident memory'
)

cmd_kill_port() {
    if (($# != 1)) || [[ ! "$1" =~ '^[0-9]+$' ]]; then
        print -u2 -r -- "Usage: proc kill-port PORT"
        return 2
    fi

    local -a pids=()
    local pid
    while IFS= read -r pid; do
        [[ -n "$pid" ]] && pids+=("$pid")
    done < <(lsof -ti:"$1" 2>/dev/null)
    ((${#pids[@]})) || {
        print -r -- "no process listening on $1"
        return 0
    }
    for pid in "${pids[@]}"; do
        kill -9 "$pid" || return $?
    done
    print -r -- "killed $1"
}

cmd_grep() {
    ps aux | grep -i "$1" | grep -v grep
}

cmd_ports() {
    if [ $# -eq 0 ]; then
        sudo lsof -iTCP -sTCP:LISTEN -n -P
    elif [ $# -eq 1 ]; then
        sudo lsof -iTCP -sTCP:LISTEN -n -P | grep -i -- "$1"
    else
        echo "Usage: proc ports [pattern]"
    fi
}

cmd_memory() {
    ps -eo pid,rss,comm -m | awk 'NR==1{printf "%6s %10s  %s\n",$1,$2,$3} NR>1{printf "%6d %8.2f MB  %s\n",$1,$2/1024,$3}' | head -30
}

family_main "$@"
