#!/usr/bin/env bash
source "$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/lib/dotfiles-shell.sh"

TMUX_SOCKET="${TMUX_SOCKET:-$HOME/.tmp/socket}"
TMUX_ARGS=()
TMUX_EXEC='tmux'
if [[ -z "${TMUX:-}" ]]; then
    TMUX_ARGS=(-S "$TMUX_SOCKET")
    TMUX_EXEC="tmux -S $(printf '%q' "$TMUX_SOCKET")"
fi

tmux_cmd() {
    command tmux "${TMUX_ARGS[@]}" "$@"
}

function homename() {
    printf '%s\n' "${1/#\~\//$HOME/}"
}

function fzf_window() {
    fzf --cycle --border-label "tmux-fzf-session - ctrl+d: delete session" --reverse --no-sort \
        --border "sharp" \
        --info inline \
        --height 100% \
        $FZF_COLORS \
        --prompt "> " \
        --preview "bash \"$DOTFILES_DIR/bin/tmux-fzf-preview\" {}" \
        --header "ctrl+d: Delete session" \
        --preview-window right,70% --bind "ctrl-d:execute-silent($TMUX_EXEC kill-session -t {2..})+abort"
}

function getProjects() {
    tmux_cmd list-sessions | awk '{ print "[s] " $1 }' | sed 's/:$//1'
    fd -p -t directory -a -d 2 "./Documents" ~/Documents | sed "s@$HOME/Documents/@[d] @g" | grep -e '.*/.*/' | sed 's/\/$//g'
}

function selectProject() {
    PROJECT=$(getProjects | fzf_window)
    if [ "${PROJECT:0:3}" == "[d]" ]; then
        SANITIZE="${PROJECT#\[d] }"
        printf '%s\n' "$HOME/Documents/$SANITIZE"
    fi
    if [ "${PROJECT:0:3}" == "[s]" ]; then
        printf '%s\n' "$PROJECT"
    fi
    exit
}

function isSelected() {
    [[ "$1" == "[s] "* ]] && printf '1\n'
}

function sanitizeName() {
    case "$1" in
    "[s] "*) printf '%s\n' "${1#\[s\] }" ;;
    *) printf '%s\n' "$1" ;;
    esac
}

function getSessionName() {
    project_dir=$1
    directory=$(basename "$project_dir")
    session_name=$(echo "$directory" | tr ' .:' '_')
    echo "$session_name"
}

selected=$(selectProject)
if [ -z "$selected" ]; then
    selected="localhost"
    echo "SELECTED '$selected'"
fi

is_session=$(isSelected "$selected")
selected_name=$(sanitizeName "$selected")
session_name=$(getSessionName "$(homename "$selected_name")")

if [[ -n "$is_session" ]]; then
    if [[ -n "${TMUX:-}" ]]; then
        tmux_cmd switch-client -t "$session_name"
    else
        tmux_cmd attach-session -t "$session_name"
    fi
else
    FULL_PATH="$(zoxide query "$selected" 2>/dev/null || true)"
    if [[ -d "$FULL_PATH" ]]; then
        tmux_cmd new-session -d -s "$session_name" -c "$FULL_PATH"
        target_session="$session_name"
    else
        tmux_cmd new-session -d -s "$selected"
        target_session="$selected"
    fi
    if [[ -n "${TMUX:-}" ]]; then
        tmux_cmd switch-client -t "$target_session"
    else
        tmux_cmd attach-session -t "$target_session"
    fi
fi
